# ---------------------------------------------------------------------------
# Allan Dev — variáveis de ambiente
# No Square Cloud: aplicação → Configurações → Variáveis de ambiente.
# Localmente: exporte no shell (o app não lê .env automaticamente).
# NUNCA commite valores reais — este arquivo é só um modelo.
# ---------------------------------------------------------------------------

# Flask
# Chave que assina o cookie de sessão. Gere uma com:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Se NÃO definir, o app gera uma aleatória e a guarda em instance/secret_key
# (permissão 0600, fora do git) para as sessões sobreviverem a reinícios.
# Defina-a no ambiente se o disco do app for apagado a cada deploy.
# (Os valores de exemplo antigos são ignorados por serem públicos.)
# SECRET_KEY=
# PORT=80
# DEBUG=0
# DB_PATH=/caminho/para/blog.db

# --- Segurança --------------------------------------------------------------
# Site servido por HTTPS (Square Cloud serve): marca o cookie de sessão como
# Secure. NÃO ligue em http:// local — o navegador não devolveria o cookie.
# HTTPS=1

# Há um proxy reverso na frente do app (Square Cloud): 1 = confiar em 1 proxy
# (use 2, 3... se houver mais saltos). O app passa a usar X-Forwarded-For/Host/Proto
# para o IP real (limite de tentativas de login) e o host real (checagem de origem).
# Sem isso, todos os usuários parecem ter o IP do proxy. NÃO ligue sem proxy:
# qualquer cliente poderia forjar o IP e burlar o limite.
# TRUST_PROXY=1

# Protege o painel /painel-allan-dev: se definida, só usuários LOGADOS com email
# nesta lista (separados por vírgula) acessam; os demais recebem 404.
# Se vazia/ausente, o painel fica ABERTO, sem senha (comportamento atual) e o app
# registra um aviso no log ao iniciar.
# ADMIN_EMAILS=voce@exemplo.com,outro@exemplo.com

# Limites (em memória, por processo): login = 5 falhas por IP+email a cada 15 min.
# Cadastro = 10 por IP por hora (suba se muitos alunos compartilham o mesmo IP/rede).
# CADASTRO_MAX_POR_HORA=10

# POST/PUT/PATCH/DELETE com Origin/Referer de outro host recebem 403 (CSRF leve).
# O host aceito é o da requisição, X-Forwarded-Host e o host de SITE_URL (abaixo);
# se atrás do proxy tudo der 403, defina SITE_URL e/ou TRUST_PROXY=1.

# --- Atividades com IA (OpenRouter) ----------------------------------------
# Chave em https://openrouter.ai/keys (obrigatória para gerar atividades).
OPENROUTER_API_KEY=

# Modelo que gera as atividades (padrão: anthropic/claude-haiku-4.5)
# OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Modelo rápido/barato para corrigir respostas abertas e gerar dicas
# OPENROUTER_MODEL_RAPIDO=openai/gpt-4o-mini

# Fallbacks (opcional), separados por vírgula — usados se o modelo principal falhar
# OPENROUTER_FALLBACK_MODELS=google/gemini-2.5-flash,openai/gpt-4o-mini

# Gerações por aluno por dia (padrão 20; 0 = sem limite)
# IA_LIMITE_DIARIO=20
# (atividades de posts já em cache — "Praticar este post" — não gastam essa cota)

# Perguntas ao tutor "Travei?" do laboratório por aluno por dia (padrão 40; 0 = sem limite).
# Usa o modelo rápido (OPENROUTER_MODEL_RAPIDO) com respostas curtas (~350 tokens).
# IA_LIMITE_TUTOR_DIARIO=40

# URL pública do site, enviada como HTTP-Referer para a OpenRouter (opcional)
# SITE_URL=https://allandev-blog.squareweb.app

# Modo demonstração offline: atividades fictícias, sem chave e sem custo
# IA_MOCK=1
# IA_MOCK_DELAY=1.2
